<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="camera">
      <link name="rgbd_frame">
        <visual>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.02 0.07 0.03"/>
          </geometry>
          <material name="black">
            <color rgba="0 0 0 1"/>
          </material>
        </visual>

        <collision>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="0.02 0.07 0.03"/>
          </geometry>
        </collision>

        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.1"/>
          <inertia ixx="${(1/12) * 0.1 * ((0.07  * 0.07)  + (0.03 * 0.03))}" ixy="0.0" ixz="0.0"
                   iyy="${(1/12) * 0.1 * ((0.02 * 0.02) + (0.03 * 0.03))}" iyz="0.0"
                   izz="${(1/12) * 0.1 * ((0.02 * 0.02) + (0.07  * 0.07))}"/>
        </inertial>
            
      </link>
    
      <joint name="camera_to_base_link" type="fixed">
        <parent link="base_link"/>
        <child link="rgbd_frame" />
        <origin xyz="0.221 0.0 0.108" rpy="0 -0.6106 0"/>
      </joint>

      <!-- <gazebo reference="camera">
        <sensor name="robot_cam" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>robot_cam</topic>
          <enable_metrics>true</enable_metrics>
        </sensor>
      </gazebo> -->

      <gazebo reference="rgbd_frame">
      <sensor type="depth" name="rgbd_sensor">
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <gz_frame_id>rgbd_frame</gz_frame_id>
        <topic>robot_cam</topic>
        <camera>
          <horizontal_fov>${63.0*3.144159265/180.0}</horizontal_fov>
          <image>
            <format>B8G8R8</format>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>z
            <near>0.1</near>
            <far>8.0</far>
          </clip>
          <distortion>
            <k1>0.00000001</k1>
            <k2>0.00000001</k2>
            <k3>0.00000001</k3>
            <p1>0.00000001</p1>
            <p2>0.00000001</p2>
          </distortion>
        </camera>
        <plugin name="rgbd_frame_controller" filename="libgazebo_ros_camera.so">
          <camera_name>rgbd</camera_name>
          <!-- <ros> -->
            <!-- <namespace>${name}</namespace> -->
            <!-- <remapping>rgbd/image_raw:=rgbd/rgb/image_raw</remapping>
            <remapping>rgbd/camera_info:=rgbd/rgb/camera_info</remapping>
            <remapping>rgbd/depth/image_raw:=rgbd/depth_registered/image_raw</remapping>
            <remapping>rgbd/depth/camera_info:=rgbd/depth_registered/camera_info</remapping>
            <remapping>rgbd/points:=rgbd/depth_registered/points</remapping> -->
          <!-- </ros> -->
          <frame_name>rgbd_frame</frame_name>
          <min_depth>0.1</min_depth>
          <max_depth>8.0</max_depth>
        </plugin>
      </sensor>
    </gazebo>

    </xacro:macro>
</robot>